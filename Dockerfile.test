# Dockerfile for running tests
FROM rust:1.83-slim

# Install PostgreSQL client and Diesel CLI
RUN apt-get update && \
    apt-get install -y postgresql-client libpq-dev && \
    cargo install diesel_cli --no-default-features --features postgres --version 2.2.12 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy all source code
COPY . .

# Build tests (dependencies will be cached by Docker layers)
RUN cargo build --tests

# Default command runs tests
CMD ["cargo", "test", "--", "--test-threads=1"]
