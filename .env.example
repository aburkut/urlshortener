# Server Configuration
PORT=8080

# Database Configuration (Rocket.toml handles this, but you can also use env vars)
# DATABASE_URL=postgres://user:password@localhost/urlshortener

# URL Shortener Configuration
SHORT_ID_LENGTH=7
MAX_COLLISION_ATTEMPTS=10
ENABLE_DEDUPLICATION=true

# TTL Configuration (optional, in days)
# DEFAULT_TTL_DAYS=30

# CORS Configuration
CORS_ALLOWED_ORIGINS=*

# Logging Configuration
# Options: trace, debug, info, warn, error
RUST_LOG=info

# For specific module logging:
# RUST_LOG=urlshortener=debug,rocket=info
